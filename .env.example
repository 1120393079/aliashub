NODE_ENV=production
PORT=4180
HOST=127.0.0.1
DATABASE_PATH=./data/outlook-alias-hub.db
DATA_DIR=./data
PUBLIC_BASE_URL=http://127.0.0.1:4180
SEED_DEMO=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-local-password
SESSION_SECRET=replace-with-a-long-random-value
DATA_ENCRYPTION_KEY=replace-with-a-separate-long-random-value
EXTENSION_API_KEY=replace-with-a-separate-connector-key
ICLOUD_PRIVACY_INTERNAL_KEY=replace-with-a-separate-internal-key

# Optional overrides for one-click Mail.com official-alias creation. The
# official Docker image installs Debian Chromium at this fixed path. Native
# installs using Google Chrome should change it to /usr/bin/google-chrome.
# The browser context is temporary and never writes a profile or storage state.
MAILCOM_BROWSER_EXECUTABLE=/usr/bin/chromium
MAILCOM_ALIAS_HEADLESS=true
MAILCOM_ALIAS_MAX_BROWSERS=1
MAILCOM_ALIAS_BROWSER_WAIT_TIMEOUT_MS=5000

# Optional bundled registration worker. Core mode leaves the service and mailbox
# URLs empty, so registration stays disabled. compose.full.yaml supplies safe
# container-network defaults for both URLs.
REGISTRATION_SERVICE_URL=
# setup-local.sh generates this shared secret. In full mode it is both the
# worker APP_PASSWORD and AliasHub's REGISTRATION_SERVICE_TOKEN.
REGISTRATION_SERVICE_TOKEN=
REGISTRATION_MAILBOX_URL=
# Browser-visible noVNC URL. Leave empty for the local loopback default; use an
# HTTPS reverse-proxy URL for a remote deployment.
REGISTRATION_BROWSER_URL=
REGISTRATION_WORKER_PORT=8000
REGISTRATION_BROWSER_PORT=6080
REGISTRATION_VNC_PASSWORD=

# Optional bundled buyer pickup service. Full Compose mode connects AliasHub to
# this service over the container network. Configure the public URL and inbound
# mail domain for your own deployment; never commit the generated secrets.
PICKUP_SERVICE_URL=
PICKUP_PUBLIC_BASE_URL=http://127.0.0.1:4190
PICKUP_PORT=4190
PICKUP_EMAIL_DOMAIN=example.com
PICKUP_INBOUND_TOKEN=
PICKUP_TOKEN_SECRET=
PICKUP_ADMIN_USERNAME=admin
PICKUP_ADMIN_PASSWORD=
PICKUP_LDXP_GOODS_ID=0
PICKUP_LDXP_IMAGE_URL=

# Optional bundled PayPal payment-link extractor. Core mode leaves its URL
# empty. Full Compose uses the internal service URL and a dedicated password
# generated by setup-local.sh; never reuse or commit that generated password.
PAYMENT_LINK_SERVICE_URL=
PAYMENT_LINK_SERVICE_PASSWORD=
PAYMENT_LINK_SERVICE_PORT=18794
PAYMENT_LINK_TASK_WORKERS=4
PAYMENT_LINK_TASK_TTL_SECONDS=3600
PAYMENT_LINK_TASK_EVENT_HISTORY_SIZE=500
PAYMENT_LINK_LOG_LEVEL=INFO
PAYMENT_LINK_LOG_JSON=false
PAYMENT_LINK_IPROCKET_PRE_PROXY_HOST=
PAYMENT_LINK_IPROCKET_PRE_PROXY_PORT=3251

# Optional server-side Microsoft registrar. On Linux it runs the bundled
# Windows x64 console tools through Wine + Xvfb from this directory.
MICROSOFT_REGISTRATION_RUNNER_DIR=./release/microsoft-registration-runner
MICROSOFT_REGISTRATION_WINE_BINARY=wine
MICROSOFT_REGISTRATION_XVFB_BINARY=xvfb-run

# Configure the optional SUB2-compatible service in the AliasHub web settings.
# Alternatively, set both values here as server-side deployment secrets. Values
# configured in the web UI are encrypted in SQLite. Never commit a real API Key.
SUB2_BASE_URL=
SUB2_ADMIN_API_KEY=

# Optional least-privilege PostgreSQL reader for copying freshly rotated OAuth
# credentials from a locally hosted SUB2-compatible service back to the bundled
# registration worker before an account status check. Leave all three empty
# when the compatible service is remote or does not expose this integration.
NFAPI_CREDENTIAL_DB_HOST=
NFAPI_CREDENTIAL_DB_NAME=
NFAPI_CREDENTIAL_DB_USER=

# Public desktop client used with Authorization Code + PKCE; no client secret.
MICROSOFT_PUBLIC_CLIENT_ID=8787a430-6eee-41e1-b914-681d90d35625

# Optional Google OAuth integration. Create an OAuth Web application in Google
# Cloud Console, then set its Client ID and Client Secret together.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Add this exact loopback callback to the OAuth application's redirect URIs.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:12142/
