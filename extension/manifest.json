{
  "manifest_version": 3,
  "name": "注册工作站 Outlook 连接器",
  "version": "1.1.3",
  "description": "将注册工作站任务连接到 Microsoft 官方 Outlook 别名页面。",
  "permissions": ["storage", "tabs", "cookies"],
  "host_permissions": [
    "__ALIAS_HUB_HOST_PERMISSION__",
    "http://localhost/*",
    "*://*.live.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "注册工作站连接器",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://account.live.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
