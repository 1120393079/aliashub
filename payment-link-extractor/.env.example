# Workbench/API authentication. Use a unique random value in production.
OPLL_WEB_PASSWORD=replace-with-a-long-random-value

# Optional command-line defaults. AliasHub sends the account token and both
# proxies per task, so these normally remain empty in Full Compose mode.
OPLL_AT=
OPLL_CHECKOUT_PROXY=
OPLL_UPDATE_PROXY=
OPLL_STRIPE_HCAPTCHA_TOKEN=

# DE uses EUR, TR uses USD, and GB uses GBP. Leave FORCE_COUNTRY empty so the
# API may select one of the supported countries for each task.
OPLL_COUNTRY=DE
OPLL_FORCE_COUNTRY=
OPLL_PAYMENT_METHOD=paypal
OPLL_UPDATE_CHECKOUT=true
# Complete Checkout rounds when ChatGPT approval returns blocked.
OPLL_RETRY_COUNT=3

OPLL_WEB_HOST=127.0.0.1
OPLL_WEB_PORT=18794
OPLL_TASK_WORKERS=4
OPLL_TASK_TTL_SECONDS=3600
OPLL_TASK_EVENT_HISTORY_SIZE=500

# Optional IPRocket subscription and file-backed proxy defaults.
OPLL_PROXY_SOURCE_URL=
OPLL_PROXY_POOL_FILE=
IPROCKET_CHAIN_PROXY=http://127.0.0.1:18796
IPROCKET_BRIDGE_PORT=18796
# Leave blank to connect to the selected upstream proxy directly. Set a SOCKS5
# host and port only when the upstream proxy must be reached through a pre-proxy.
IPROCKET_PRE_PROXY_HOST=
IPROCKET_PRE_PROXY_PORT=3251

OPLL_LOG_LEVEL=INFO
OPLL_LOG_FILE=./data/payment-link.log
OPLL_LOG_JSON=false
